  "routing": {
    "affinity-vector-or-logo-work": "brandkit-affinity",
    "brand-package-generation": "brandkit-build",
    "design-md-generation-or-validation": "brandkit-impeccable",
    "general-ui-redesign": "brandkit-impeccable -> impeccable",
    "pdf-publication-or-layout": "brand-voice-pdf -> brandkit-publish",
    "spacing-audit-or-token-role": "brandkit-spacing",
    "visual-brand-candidates": "brandkit-visual-decisions"
  },
  "schema_version": "brandkit-skill-contract.v1",
  "sequence": [
    "brandkit-setup",
    "brandkit-interview",
    "brandkit-visual-decisions",
    "brandkit-build",
    "brandkit-publish"
  ],
  "skills": {
    "brandkit-build": {
      "fails_on": [
        "missing_provenance",
        "normative_brand_conflict",
        "unresolved_asset_rights",
        "missing_brand_pin",
        "instruction_copy"
      ],
      "gate": "package validates and every normative value has provenance",
      "inputs": [
        "brand-raw.md",
        "source_pointers",
        "setup-readiness.md"
      ],
      "outputs": [
        "brand-package.v1",
        "AGENTS.md",
        "CLAUDE.md -> AGENTS.md",
        "Hermes cwd/AGENTS.md"
      ],
      "owner": "normative-brand-package"
    },
    "brandkit-interview": {
      "fails_on": [
        "missing_owner",
        "normative_brand_conflict",
        "unsupported_legal_claim"
      ],
      "gate": "required axes are sourced, explicitly open, or not applicable and no normative conflict remains",
      "inputs": [
        "setup-readiness.md",
        "owner_answers",
        "supplied_sources"
      ],
      "outputs": [
        "brand-raw.md",
        "conflict_register",
        "open_item_register"
      ],
      "owner": "brand-source-capture"
    },
    "brandkit-publish": {
      "fails_on": [
        "missing_brand_pin",
        "missing_fact",
        "legal_review_todo",
        "unsupported_legal_claim",
        "protected_fact_mutation",
        "brand_conflict",
        "unresolved_asset_rights",
        "markdown_contract_failure",
        "missing_or_rejected_humanizer_evidence",
        "generic_smoothing",
        "improper_impeccable_handoff",
        "open_todo",
        "renderer_evidence_failure",
        "visual_review_failure"
      ],
      "gate": "brand, facts, rights, contracts, renderer and visual review pass with no open-work marker",
      "inputs": [
        "brand_pin",
        "approved_content",
        "document_type",
        "target_medium",
        "review_evidence",
        "humanizer_applicability=required"
      ],
      "outputs": [
        "artifact",
        "qa_report",
        "fact_ledger",
        "humanizer_evidence"
      ],
      "owner": "project-artifact-production"
    },
    "brandkit-setup": {
      "fails_on": [
        "missing_write_target",
        "ambiguous_project_root",
        "required_capability_without_fallback"
      ],
      "gate": "required capabilities have observed evidence or accepted fallback",
      "inputs": [
        "requested_outputs",
        "project_root",
        "supplied_sources"
      ],
      "outputs": [
        "setup-readiness.md"
      ],
      "owner": "readiness-and-scope"
    },
    "brandkit-visual-decisions": {
      "fails_on": [
        "stale_visual_brief",
        "unverified_candidate",
        "missing_rights",
        "forbidden_affinity_fallback",
        "global_impeccable_prebuild"
      ],
      "gate": "open visual domains are skipped, candidate-ready, partial, or blocked from verified run-local evidence",
      "inputs": [
        "brand-raw.md",
        "visual-brief",
        "source-review",
        "affinity-observation"
      ],
      "outputs": [
        "candidate-bundle",
        "unselected-candidate-review",
        "visual-evidence"
      ],
      "owner": "non-normative-visual-candidates"
    }
  },
  "todo_policy": {
    "allowed_locations": [
      "brand-raw.md",
      ".brandkit/work"
    ],
    "publication_blocks_any_todo": true,
    "required_forms": [
      "TODO(owner)",
      "TODO(legal-review)"
    ]
  },
  "visual_decisions": {
    "build_gate": "required open visual domain => package-draft-only; package-ready requires byte-identical consumed visual block or no open visual domain",
    "confirmation_return": "brandkit-visual-decisions:review-candidates -> owner-selection-chat -> brandkit-interview:prepare-visual-confirmation -> owner-review -> confirm -> brandkit-interview:consume-visual-decisions -> brandkit-build",
    "domain_states": [
      "confirmed",
      "open",
      "not-applicable"
    ],
    "domains": [
      "color",
      "typography",
      "code-font",
      "logo",
      "lockup"
    ],
    "impeccable_prebuild": "run-local pinned resolver only; extract forbidden",
    "operations": [
      "capture",
      "prepare-visual-confirmation",
      "consume-visual-decisions"
    ],
    "outcomes": [
      "not-applicable",
      "candidates-ready",
      "partial",
      "blocked"
    ]
  }
