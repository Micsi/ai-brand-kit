{
  "humanizer_policy": {
    "applicability": "required",
    "model_call_contract": "Claude Code 2.1.223 only: closed full raw result envelope including usage/modelUsage/permission fields; Codex CLI 0.144.3 is unsupported and fail-closed as the pinned release's LLM provider; every raw call byte hash is bound in report.json and BrandKit provenance",
    "null_edit_allowed": true,
    "old_hash_semantics": "validates the addressed baseline segment; replacement bytes may and normally do hash differently",
    "passes": "Pass 0 triage; Pass 1 evidence/artifacts; confirmed-cluster Passes 2-4; Pass 5 self-audit",
    "pattern_catalog_contract": "pinned references/patterns.md revision/hash plus the exact canonical ids 1..72; aliases, duplicates and malformed or unknown ids fail",
    "protected": [
      "frontmatter",
      "facts",
      "links",
      "quotes",
      "code",
      "tables",
      "callouts",
      "ids",
      "structure"
    ],
    "provenance_contract": "BrandKit-derived brandkit-provenance.json is regenerated from canonical UTF-8/LF original and result raw bytes, confirmed edits and exact Unicode-codepoint spans; its raw before/after hashes equal manifest, lint and report bindings",
    "required_evidence": [
      "original.md",
      "preflight.json",
      "audit-call.json",
      "audit-ledger.json",
      "confirmed-ledger.json",
      "edits.json",
      "rewrite-call.json|null-edit",
      "evidence-ledger.json",
      "evidence-report.json",
      "changes.diff",
      "brandkit-provenance.json",
      "report.json",
      "result.md|rejected.md"
    ],
    "runner": "scripts/humanizer_two_pass.py --file <file> --out-dir <empty-dir>",
    "scope": "mutable single-line prose segments from the markdown contract"
  },
  "impeccable_policy": {
    "adapter": "brandkit-impeccable",
    "handoff": [
      "brand_pin",
      ".brandkit/impeccable-product.json"
    ],
    "parallel_design_instructions": false,
    "required_outputs_before_route": [
      "PRODUCT.md",
      "DESIGN.md"
    ]
  },
  "legal_policy": {
    "accepted_basis": "official source supplied by the user",
    "fallback": "TODO(legal-review)",
    "publication_without_review": false
  },
  "optional_adapters": {
    "brandkit-affinity": {
      "fails_on": [
        "affinity_unavailable",
        "affinity_identity_ambiguous",
        "missing_mutation_receipt",
        "receipt_scope_mismatch",
        "non_staging_write",
        "unverified_export"
      ],
      "gate": "a live loopback Affinity MCP server is observed; every mutation is explicitly authorized, receipt-bound and confined to run-local staging",
      "inputs": [
        "visual_brief",
        "project_root",
        "run_id",
        "affinity_server_observation",
        "optional_mutation_receipt"
      ],
      "mutates": [
        ".brandkit/work/<run-id>/visual-decisions/staging/<document-id>"
      ],
      "outputs": [
        "read_only_capability_observation",
        "staged_vector_artifact",
        "export_inventory",
        "mutation_evidence"
      ],
      "owner": "affinity-vector-authoring-and-evidence",
      "read_only": [
        "brand-raw.md",
        "visual-brief",
        "owner-source-assets",
        "brand-package.v1"
      ]
    },
    "brandkit-spacing": {
      "fails_on": [
        "missing_brand_pin",
        "ambiguous_target_medium",
        "normative_spacing_conflict",
        "unknown_spacing_provenance",
        "medium_namespace_collision",
        "forbidden_spacing_mutation"
      ],
      "gate": "one pinned brand and one medium namespace resolve; every inventory entry maps to exactly one token or evidenced exception",
      "inputs": [
        "brand_pin",
        "target_medium",
        "target_scope",
        "hashed_spacing_inventory"
      ],
      "mutates": [],
      "outputs": [
        "closed_spacing_result",
        "unconfirmed_spacing_token_proposal",
        "validated_spacing_roles",
        "spacing_audit_findings",
        "ui_patch_handoff"
      ],
      "owner": "spacing-tokens-roles-and-audit",
      "read_only": [
        "brand-package.v1",
        "shared_visual_tokens.spacing",
        "pdf.tokens",
        "document-type-layout",
        "DESIGN.md"
      ]
    }
  },
