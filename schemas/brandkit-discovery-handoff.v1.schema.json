{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "brandkit-discovery-handoff.v1.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "run_id", "workspace", "sources", "decisions", "recommendations", "files"],
  "properties": {
    "schema_version": {"const": "brandkit-discovery-handoff.v1"},
    "run_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"},
    "workspace": {"type": "string", "pattern": "^\\.brandkit/work/[a-z0-9][a-z0-9-]{0,62}/discovery$"},
    "sources": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["id", "classification", "file"], "properties": {"id": {"$ref": "#/$defs/id"}, "classification": {"enum": ["owner-supplied", "official-supplied", "observed"]}, "file": {"$ref": "#/$defs/path"}}}},
    "decisions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/decision"}},
    "recommendations": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "text"], "properties": {"id": {"$ref": "#/$defs/id"}, "text": {"type": "string", "minLength": 1}}}},
    "files": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/file"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}$"},
    "path": {"type": "string", "pattern": "^\\.brandkit/work/[a-z0-9][a-z0-9-]{0,62}/discovery/[A-Za-z0-9._/-]+$"},
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "decision": {"type": "object", "additionalProperties": false, "required": ["id", "value", "source_ids"], "properties": {"id": {"$ref": "#/$defs/id"}, "value": {"type": "string", "minLength": 1}, "source_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}}},
    "file": {"type": "object", "additionalProperties": false, "required": ["path", "role", "size", "sha256"], "properties": {"path": {"$ref": "#/$defs/path"}, "role": {"enum": ["context", "adr", "source"]}, "size": {"type": "integer", "minimum": 0}, "sha256": {"$ref": "#/$defs/hash"}}}
  }
}
