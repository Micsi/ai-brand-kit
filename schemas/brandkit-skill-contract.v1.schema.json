{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "brandkit-skill-contract.v1.schema.json", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "sequence", "skills", "optional_adapters", "routing", "todo_policy", "legal_policy", "humanizer_policy", "impeccable_policy", "public_contracts", "progressive_disclosure"],
  "properties": {
    "schema_version": {"const": "brandkit-skill-contract.v1"}, "sequence": {"const": ["brandkit-setup", "brandkit-interview", "brandkit-build", "brandkit-publish"]},
    "skills": {"type": "object", "additionalProperties": false, "required": ["brandkit-setup", "brandkit-interview", "brandkit-build", "brandkit-publish"], "properties": {"brandkit-setup": {"$ref": "#/$defs/skill"}, "brandkit-interview": {"$ref": "#/$defs/skill"}, "brandkit-build": {"$ref": "#/$defs/skill"}, "brandkit-publish": {"$ref": "#/$defs/skill"}}},
    "optional_adapters": {"type": "object", "additionalProperties": false, "required": ["brandkit-spacing"], "properties": {"brandkit-spacing": {"$ref": "#/$defs/adapter"}}},
    "routing": {"type": "object", "additionalProperties": false, "required": ["spacing-audit-or-token-role", "general-ui-redesign", "brand-package-generation", "pdf-publication-or-layout", "design-md-generation-or-validation"], "properties": {"spacing-audit-or-token-role": {"type": "string"}, "general-ui-redesign": {"type": "string"}, "brand-package-generation": {"type": "string"}, "pdf-publication-or-layout": {"type": "string"}, "design-md-generation-or-validation": {"type": "string"}}},
    "todo_policy": {"type": "object", "additionalProperties": false, "required": ["allowed_locations", "required_forms", "publication_blocks_any_todo"], "properties": {"allowed_locations": {"$ref": "#/$defs/strings"}, "required_forms": {"$ref": "#/$defs/strings"}, "publication_blocks_any_todo": {"type": "boolean"}}},
    "legal_policy": {"type": "object", "additionalProperties": false, "required": ["accepted_basis", "fallback", "publication_without_review"], "properties": {"accepted_basis": {"type": "string"}, "fallback": {"type": "string"}, "publication_without_review": {"type": "boolean"}}},
    "humanizer_policy": {"type": "object", "additionalProperties": false, "required": ["applicability", "scope", "runner", "passes", "protected", "old_hash_semantics", "pattern_catalog_contract", "model_call_contract", "provenance_contract", "required_evidence", "null_edit_allowed"], "properties": {"applicability": {"type": "string"}, "scope": {"type": "string"}, "runner": {"type": "string"}, "passes": {"type": "string"}, "protected": {"$ref": "#/$defs/strings"}, "old_hash_semantics": {"type": "string"}, "pattern_catalog_contract": {"type": "string"}, "model_call_contract": {"type": "string"}, "provenance_contract": {"type": "string"}, "required_evidence": {"$ref": "#/$defs/strings"}, "null_edit_allowed": {"type": "boolean"}}},
    "impeccable_policy": {"type": "object", "additionalProperties": false, "required": ["adapter", "handoff", "required_outputs_before_route", "parallel_design_instructions"], "properties": {"adapter": {"type": "string"}, "handoff": {"$ref": "#/$defs/strings"}, "required_outputs_before_route": {"$ref": "#/$defs/strings"}, "parallel_design_instructions": {"type": "boolean"}}},
    "public_contracts": {"type": "object", "additionalProperties": false, "required": ["cli", "python", "brand_package", "documents"], "properties": {
      "cli": {"type": "object", "additionalProperties": false, "required": ["scripts/brand_package.py", "scripts/brand_voice_pdf.py", "scripts/markdown_contract.py", "scripts/materialize_brandkit_instructions.py"], "properties": {"scripts/brand_package.py": {"$ref": "#/$defs/cli"}, "scripts/brand_voice_pdf.py": {"$ref": "#/$defs/cli"}, "scripts/markdown_contract.py": {"$ref": "#/$defs/cli"}, "scripts/materialize_brandkit_instructions.py": {"$ref": "#/$defs/cli"}}},
      "python": {"type": "object", "additionalProperties": false, "required": ["scripts/brand_package.py", "scripts/brand_voice_pdf.py", "scripts/markdown_contract.py", "scripts/materialize_brandkit_instructions.py"], "properties": {"scripts/brand_package.py": {"$ref": "#/$defs/symbols"}, "scripts/brand_voice_pdf.py": {"$ref": "#/$defs/symbols"}, "scripts/markdown_contract.py": {"$ref": "#/$defs/symbols"}, "scripts/materialize_brandkit_instructions.py": {"$ref": "#/$defs/symbols"}}},
      "brand_package": {"$ref": "#/$defs/schemaBinding"},
      "documents": {"type": "object", "additionalProperties": false, "required": ["schema", "validator", "types"], "properties": {"schema": {"type": "string"}, "validator": {"$ref": "#/$defs/pythonLocator"}, "types": {"type": "object", "additionalProperties": false, "required": ["freeform", "offer", "one-pager", "report"], "properties": {"freeform": {"type": "string"}, "offer": {"type": "string"}, "one-pager": {"type": "string"}, "report": {"type": "string"}}}}}
    }},
    "progressive_disclosure": {"type": "object", "additionalProperties": false, "required": ["rule", "catalog", "routes", "impeccable", "design_context"], "properties": {
      "rule": {"type": "string"}, "catalog": {"type": "object", "minProperties": 16, "additionalProperties": {"$ref": "#/$defs/catalogEntry"}},
      "routes": {"type": "object", "additionalProperties": false, "required": ["setup", "interview", "build", "publish", "spacing", "impeccable-sync", "pdf"], "properties": {"setup": {"$ref": "#/$defs/route"}, "interview": {"$ref": "#/$defs/route"}, "build": {"$ref": "#/$defs/route"}, "publish": {"$ref": "#/$defs/route"}, "spacing": {"$ref": "#/$defs/route"}, "impeccable-sync": {"$ref": "#/$defs/route"}, "pdf": {"$ref": "#/$defs/route"}}},
      "impeccable": {"type": "object", "additionalProperties": false, "required": ["release", "command_catalog", "reference_catalog", "context_loader", "platforms", "native_guidance"], "properties": {"release": {"type": "string"}, "command_catalog": {"type": "string"}, "reference_catalog": {"type": "string"}, "context_loader": {"type": "string"}, "platforms": {"const": ["web", "ios", "android", "adaptive"]}, "native_guidance": {"type": "object", "additionalProperties": false, "required": ["ios", "android", "adaptive"], "properties": {"ios": {"const": "ios.md"}, "android": {"const": "android.md"}, "adaptive": {"const": "adaptive"}}}}},
      "design_context": {"type": "object", "additionalProperties": false, "required": ["path", "generator", "source_of_truth", "required_sections"], "properties": {"path": {"const": "DESIGN.md"}, "generator": {"$ref": "#/$defs/pythonLocator"}, "source_of_truth": {"const": "brand-package.v1 shared_visual_tokens"}, "required_sections": {"type": "array", "minItems": 9, "uniqueItems": true, "items": {"type": "string"}}}}
    }}
  },
  "$defs": {
    "strings": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "symbols": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"}},
    "skill": {"type": "object", "additionalProperties": false, "required": ["owner", "inputs", "outputs", "gate", "fails_on"], "properties": {"owner": {"type": "string"}, "inputs": {"$ref": "#/$defs/strings"}, "outputs": {"$ref": "#/$defs/strings"}, "gate": {"type": "string"}, "fails_on": {"$ref": "#/$defs/strings"}}},
    "adapter": {"type": "object", "additionalProperties": false, "required": ["owner", "inputs", "outputs", "mutates", "read_only", "gate", "fails_on"], "properties": {"owner": {"type": "string"}, "inputs": {"$ref": "#/$defs/strings"}, "outputs": {"$ref": "#/$defs/strings"}, "mutates": {"$ref": "#/$defs/strings"}, "read_only": {"$ref": "#/$defs/strings"}, "gate": {"type": "string"}, "fails_on": {"$ref": "#/$defs/strings"}}},
    "pythonLocator": {"type": "string", "pattern": "^scripts/[a-z0-9_]+\\.py:[A-Za-z_][A-Za-z0-9_]*$"}, "cli": {"type": "object", "additionalProperties": false, "required": ["commands", "options"], "properties": {"commands": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "options": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}}},
    "schemaBinding": {"type": "object", "additionalProperties": false, "required": ["schema", "schema_version", "validator"], "properties": {"schema": {"type": "string"}, "schema_version": {"type": "string"}, "validator": {"$ref": "#/$defs/pythonLocator"}}},
    "catalogEntry": {"type": "object", "additionalProperties": false, "required": ["path", "role", "sha256"], "properties": {"path": {"type": "string"}, "role": {"enum": ["primary", "authoring", "contract", "release"]}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
    "route": {"type": "object", "additionalProperties": false, "required": ["skill", "primary", "context"], "properties": {"skill": {"type": "string"}, "primary": {"type": "string"}, "context": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}}}
  }
}
