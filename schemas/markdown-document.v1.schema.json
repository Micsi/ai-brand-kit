{
  "$id": "markdown-document.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "document_id", "document_type", "title", "lang", "status", "facts", "sources", "assets", "rights", "todos"],
  "properties": {
    "schema_version": {"const": "markdown-document.v1"},
    "document_id": {"$ref": "#/$defs/id"},
    "document_type": {"$ref": "#/$defs/id"},
    "title": {"type": "string", "minLength": 1},
    "lang": {"type": "string", "pattern": "^[a-z]{2}(?:-[A-Z]{2})?$"},
    "status": {"enum": ["draft", "review", "release"]},
    "facts": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "value", "source_ids"], "properties": {"id": {"$ref": "#/$defs/id"}, "value": {"type": ["string", "number", "boolean"]}, "source_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}}}},
    "sources": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "locator", "sha256"], "properties": {"id": {"$ref": "#/$defs/id"}, "locator": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/hash"}}}},
    "assets": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "path", "media_type", "sha256", "rights_id"], "properties": {"id": {"$ref": "#/$defs/id"}, "path": {"type": "string", "pattern": "^assets/[A-Za-z0-9][A-Za-z0-9._/-]*$"}, "media_type": {"enum": ["image/png", "image/jpeg", "image/svg+xml"]}, "sha256": {"$ref": "#/$defs/hash"}, "rights_id": {"$ref": "#/$defs/id"}}}},
    "rights": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "evidence_path", "evidence_sha256"], "properties": {"id": {"$ref": "#/$defs/id"}, "evidence_path": {"type": "string", "pattern": "^rights/[A-Za-z0-9][A-Za-z0-9._/-]*$"}, "evidence_sha256": {"$ref": "#/$defs/hash"}}}},
    "todos": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "reason"], "properties": {"id": {"$ref": "#/$defs/id"}, "reason": {"type": "string", "minLength": 1}}}}
  },
  "$defs": {"id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$"}, "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
