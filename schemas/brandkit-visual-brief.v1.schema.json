{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "brandkit-visual-brief.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "brief_id", "project_identity_sha256", "run_id", "brand_id", "interview_handoff", "open_decisions", "locale", "viewports", "offline", "normative"],
  "properties": {
    "schema_version": {"const": "brandkit-visual-brief.v1"},
    "brief_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"},
    "project_identity_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "run_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
    "brand_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}$"},
    "interview_handoff": {"$ref": "#/$defs/file"},
    "open_decisions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["color", "typography", "code-font", "logo", "lockup"]}},
    "locale": {"const": "de-DE"},
    "viewports": {"const": [320, 768, 1440]},
    "offline": {"const": true},
    "normative": {"const": false}
  },
  "$defs": {
    "file": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}
  }
}
