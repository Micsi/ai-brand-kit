{
  "$id": "owner-approval.v1.schema.json", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "issuer", "payload", "hmac_sha256"],
  "properties": {
    "schema_version": {"const": "owner-approval.v1"}, "issuer": {"type": "string", "minLength": 1}, "hmac_sha256": {"$ref": "#/$defs/hash"},
    "payload": {"type": "object", "additionalProperties": false,
      "required": ["decision", "final_sha256", "brand_id", "document_type_id", "workflow_lock_sha256", "project_identity_sha256", "run_id", "approved_at"],
      "properties": {"decision": {"const": "release"}, "final_sha256": {"$ref": "#/$defs/hash"}, "brand_id": {"$ref": "#/$defs/id"}, "document_type_id": {"$ref": "#/$defs/id"}, "workflow_lock_sha256": {"$ref": "#/$defs/hash"}, "project_identity_sha256": {"$ref": "#/$defs/hash"}, "run_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"}, "approved_at": {"type": "string", "format": "date-time"}}
    }
  },
  "$defs": {"hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$"}}
}
