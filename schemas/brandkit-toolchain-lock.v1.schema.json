{
  "$id": "brandkit-toolchain-lock.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "release", "execution", "environment", "components", "artifacts", "bindings", "transforms", "normative", "commands"],
  "properties": {
    "schema_version": {"const": "brandkit-toolchain-lock.v1"},
    "release": {"type": "object", "additionalProperties": false, "required": ["id", "source_revision"], "properties": {"id": {"const": "brandkit-shared-toolchain-1.2.28.2"}, "source_revision": {"const": "d651794"}}},
    "execution": {"type": "object", "additionalProperties": false, "required": ["host_platform", "render_platform", "container_image", "container_digest", "base_image", "base_image_digest", "worker_container_image"], "properties": {"host_platform": {"const": "darwin-arm64"}, "render_platform": {"const": "linux-amd64"}, "container_image": {"type": "string", "pattern": "@sha256:[0-9a-f]{64}$"}, "container_digest": {"$ref": "#/$defs/prefixed_hash"}, "base_image": {"type": "string", "pattern": "@sha256:[0-9a-f]{64}$"}, "base_image_digest": {"$ref": "#/$defs/prefixed_hash"}, "worker_container_image": {"type": "string", "pattern": "@sha256:[0-9a-f]{64}$"}}},
    "environment": {"const": {"LANG": "C", "LC_ALL": "C", "TZ": "UTC", "SOURCE_DATE_EPOCH": "0", "network": "disabled"}},
    "components": {"type": "object", "additionalProperties": false, "required": ["humanizer", "pdf_renderer", "mermaid", "mermaid_linux_worker", "graphviz"], "properties": {"humanizer": {"$ref": "#/$defs/component"}, "pdf_renderer": {"$ref": "#/$defs/component"}, "mermaid": {"$ref": "#/$defs/component"}, "mermaid_linux_worker": {"$ref": "#/$defs/component"}, "graphviz": {"$ref": "#/$defs/component"}}},
    "artifacts": {"type": "object", "additionalProperties": false, "required": ["humanizer_source", "humanizer_wheelhouse", "pdf_wheelhouse", "pdf_issuer_key", "mermaid_bundle", "graphviz_bundle", "normative_render_oci", "node_linux", "chrome_linux", "qemu_runtime"], "properties": {"humanizer_source": {"$ref": "#/$defs/artifact"}, "humanizer_wheelhouse": {"$ref": "#/$defs/artifact"}, "pdf_wheelhouse": {"$ref": "#/$defs/artifact"}, "pdf_issuer_key": {"$ref": "#/$defs/artifact"}, "mermaid_bundle": {"$ref": "#/$defs/artifact"}, "graphviz_bundle": {"$ref": "#/$defs/artifact"}, "normative_render_oci": {"$ref": "#/$defs/artifact"}, "node_linux": {"$ref": "#/$defs/artifact"}, "chrome_linux": {"$ref": "#/$defs/artifact"}, "qemu_runtime": {"$ref": "#/$defs/artifact"}}},
    "bindings": {"type": "object", "additionalProperties": false, "required": ["python_version", "python_executable", "python_sha256", "node_version", "chrome_version", "chrome_sha256", "font_path", "font_postscript_name", "font_sha256"], "properties": {"python_version": {"type": "string"}, "python_executable": {"type": "string"}, "python_sha256": {"$ref": "#/$defs/hash"}, "node_version": {"type": "string"}, "chrome_version": {"type": "string"}, "chrome_sha256": {"$ref": "#/$defs/hash"}, "font_path": {"type": "string"}, "font_postscript_name": {"type": "string"}, "font_sha256": {"$ref": "#/$defs/hash"}}},
    "transforms": {"type": "object", "additionalProperties": false, "required": ["humanizer_doctor_runtime_adapter", "network_deny_policy"], "properties": {"humanizer_doctor_runtime_adapter": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "child_timeout_seconds", "doctor_argument"], "properties": {"path": {"const": "toolchain/humanizer-doctor-runtime-adapter.py"}, "sha256": {"$ref": "#/$defs/hash"}, "child_timeout_seconds": {"const": 600}, "doctor_argument": {"const": "--require-full"}}}, "network_deny_policy": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "loopback"], "properties": {"path": {"const": "toolchain/shared-network-deny.sb"}, "sha256": {"$ref": "#/$defs/hash"}, "loopback": {"const": "allowed"}}}}},
    "normative": {"type": "object", "additionalProperties": false, "required": ["versions", "package_inventory", "version_inventory", "build", "installed_inventory", "fixtures", "gates"], "properties": {"versions": {"type": "object"}, "package_inventory": {"$ref": "#/$defs/inventory"}, "version_inventory": {"$ref": "#/$defs/inventory"}, "build": {"type": "object", "additionalProperties": false, "required": ["dockerfile", "dockerfile_sha256"], "properties": {"dockerfile": {"type": "string"}, "dockerfile_sha256": {"$ref": "#/$defs/hash"}}}, "installed_inventory": {"type": "object", "additionalProperties": {"$ref": "#/$defs/hash"}}, "fixtures": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/command"}}, "gates": {"const": {"M4": true, "M6": true, "M9": true, "U4": true}}}},
    "commands": {"type": "object", "additionalProperties": false, "required": ["implementation", "install", "verify", "version_log", "rollback", "restore", "clean_rooms"], "properties": {"implementation": {"$ref": "#/$defs/command"}, "install": {"$ref": "#/$defs/command"}, "verify": {"$ref": "#/$defs/command"}, "version_log": {"$ref": "#/$defs/command"}, "rollback": {"$ref": "#/$defs/command"}, "restore": {"$ref": "#/$defs/command"}, "clean_rooms": {"$ref": "#/$defs/command"}}}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "prefixed_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "component": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "schema_version"], "properties": {"path": {"type": "string"}, "sha256": {"$ref": "#/$defs/hash"}, "schema_version": {"type": "string"}}},
    "command": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string"}, "sha256": {"$ref": "#/$defs/hash"}}},
    "inventory": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "line_count"], "properties": {"path": {"type": "string"}, "sha256": {"$ref": "#/$defs/hash"}, "line_count": {"type": "integer", "minimum": 1}}},
    "artifact": {"type": "object", "additionalProperties": false, "required": ["kind", "path", "sha256"], "properties": {"kind": {"type": "string"}, "path": {"type": "string"}, "sha256": {"$ref": "#/$defs/hash"}, "manifest": {"type": "string"}, "manifest_sha256": {"$ref": "#/$defs/hash"}}}
  }
}
