{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://brandkit.local/schemas/mermaid-linux-worker.v2.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "platform", "engine", "execution_model", "engine_requirements", "base_image", "node_image", "source_files", "package_lock_sha256", "artifact_bundle_tree_sha256", "runtime_mount", "policy"],
  "properties": {
    "schema_version": {"const": "mermaid-linux-worker.v2"},
    "platform": {"const": "linux-arm64"},
    "engine": {"const": "colima-docker"},
    "execution_model": {"const": "buildless-image-and-bind-mounts"},
    "engine_requirements": {"type": "object", "additionalProperties": false, "required": ["minimum_server_version", "image_mount"], "properties": {"minimum_server_version": {"const": "29.0.0"}, "image_mount": {"const": true}}},
    "base_image": {"$ref": "#/$defs/image"},
    "node_image": {"$ref": "#/$defs/image"},
    "source_files": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}},
    "package_lock_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifact_bundle_tree_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "runtime_mount": {"type": "object", "additionalProperties": false, "required": ["path", "inventory_sha256", "entry_count", "size_bytes"], "properties": {"path": {"type": "string", "pattern": "^/Volumes/Daten/AgentStores/joh/runtime-store/mermaid-mmdc-mounts/[0-9a-f]{64}$"}, "inventory_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "entry_count": {"type": "integer", "minimum": 1}, "size_bytes": {"type": "integer", "minimum": 1}}},
    "policy": {"type": "object", "additionalProperties": false, "required": ["network", "read_only_root", "user", "cap_drop", "no_new_privileges", "cpus", "memory", "pids_limit", "timeout_seconds", "max_input_bytes", "shm_size", "seccomp_profile"], "properties": {"network": {"const": "none"}, "read_only_root": {"const": true}, "user": {"const": "1000:1000"}, "cap_drop": {"const": ["ALL"]}, "no_new_privileges": {"const": true}, "cpus": {"const": "1.0"}, "memory": {"const": "768m"}, "pids_limit": {"const": 128}, "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 900}, "max_input_bytes": {"const": 65536}, "shm_size": {"const": "256m"}, "seccomp_profile": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"const": "toolchain/mermaid-svg/chromium-userns-seccomp.json"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}}}
  },
  "$defs": {"image": {"type": "object", "required": ["reference", "digest", "loaded_image_id", "archive_path", "archive_sha256", "archive_size"], "properties": {"reference": {"type": "string", "pattern": "@sha256:[0-9a-f]{64}$"}, "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "loaded_image_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "archive_path": {"type": "string", "pattern": "^/Volumes/Daten/AgentStores/"}, "archive_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "archive_size": {"type": "integer", "minimum": 1}}, "additionalProperties": {"type": ["string", "number", "boolean"]}}}
}
