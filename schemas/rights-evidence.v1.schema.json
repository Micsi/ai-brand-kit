{
  "$id": "rights-evidence.v1.schema.json", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "issuer", "source", "scope", "asset_id", "license_id", "status", "version", "date", "todo"],
  "properties": {"schema_version": {"const": "rights-evidence.v1"}, "issuer": {"type": "string", "minLength": 1}, "source": {"type": "string", "minLength": 1}, "scope": {"const": "single-asset"}, "asset_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"}, "license_id": {"type": "string", "minLength": 1}, "status": {"enum": ["owned", "licensed", "open-license", "public-domain", "todo-review"]}, "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"}, "date": {"type": "string", "format": "date"}, "todo": {"type": ["string", "null"]}, "source_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "source_path": {"type": "string", "pattern": "^[A-Za-z0-9._/-]+$"}, "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "license_evidence_path": {"type": "string", "pattern": "^[A-Za-z0-9._/-]+$"}, "license_evidence_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "transformation": {"type": "string", "minLength": 1}},
  "allOf": [{"if": {"properties": {"status": {"const": "todo-review"}}}, "then": {"properties": {"todo": {"type": "string", "minLength": 1}}}, "else": {"properties": {"todo": {"type": "null"}}}}, {"if": {"properties": {"status": {"const": "open-license"}}}, "then": {"required": ["source_revision", "source_path", "source_sha256", "license_evidence_path", "license_evidence_sha256", "transformation"]}}]
}
