{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "claude-code-2.1.223-result.schema.json",
  "title": "Claude Code 2.1.223 successful --output-format json envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "is_error", "duration_api_ms", "num_turns", "stop_reason", "session_id",
    "total_cost_usd", "usage", "modelUsage", "permission_denials",
    "terminal_reason", "fast_mode_state", "fast_mode_disabled_reason",
    "subtype", "api_error_status", "result", "structured_output", "ttft_ms",
    "ttft_stream_ms", "time_to_request_ms", "type", "duration_ms", "uuid"
  ],
  "properties": {
    "is_error": {"const": false},
    "duration_api_ms": {"$ref": "#/$defs/nonnegative_integer"},
    "num_turns": {"type": "integer", "minimum": 1},
    "stop_reason": {"const": "tool_use"},
    "session_id": {"type": "string", "format": "uuid"},
    "total_cost_usd": {"type": "number", "minimum": 0},
    "usage": {"$ref": "#/$defs/usage"},
    "modelUsage": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"type": "string", "minLength": 1},
      "additionalProperties": {"$ref": "#/$defs/model_usage"}
    },
    "permission_denials": {"type": "array", "maxItems": 0},
    "terminal_reason": {"const": "completed"},
    "fast_mode_state": {"const": "off"},
    "fast_mode_disabled_reason": {"type": "string", "minLength": 1},
    "subtype": {"const": "success"},
    "api_error_status": {"type": "null"},
    "result": {"type": "string", "minLength": 2},
    "structured_output": {"type": "object"},
    "ttft_ms": {"$ref": "#/$defs/nonnegative_integer"},
    "ttft_stream_ms": {"$ref": "#/$defs/nonnegative_integer"},
    "time_to_request_ms": {"$ref": "#/$defs/nonnegative_integer"},
    "type": {"const": "result"},
    "duration_ms": {"$ref": "#/$defs/nonnegative_integer"},
    "uuid": {"type": "string", "format": "uuid"}
  },
  "$defs": {
    "nonnegative_integer": {"type": "integer", "minimum": 0},
    "cache_creation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ephemeral_1h_input_tokens", "ephemeral_5m_input_tokens"],
      "properties": {
        "ephemeral_1h_input_tokens": {"$ref": "#/$defs/nonnegative_integer"},
        "ephemeral_5m_input_tokens": {"$ref": "#/$defs/nonnegative_integer"}
      }
    },
    "iteration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_tokens", "output_tokens", "cache_read_input_tokens", "cache_creation_input_tokens", "cache_creation", "type"],
      "properties": {
        "input_tokens": {"$ref": "#/$defs/nonnegative_integer"},
        "output_tokens": {"$ref": "#/$defs/nonnegative_integer"},
        "cache_read_input_tokens": {"$ref": "#/$defs/nonnegative_integer"},
        "cache_creation_input_tokens": {"$ref": "#/$defs/nonnegative_integer"},
        "cache_creation": {"$ref": "#/$defs/cache_creation"},
        "type": {"const": "message"}
      }
    },
    "server_tool_use": {
      "type": "object",
      "additionalProperties": false,
      "required": ["web_search_requests", "web_fetch_requests"],
      "properties": {
        "web_search_requests": {"const": 0},
        "web_fetch_requests": {"const": 0}
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_tokens", "cache_creation_input_tokens", "cache_read_input_tokens",
        "output_tokens", "server_tool_use", "service_tier", "cache_creation",
        "inference_geo", "iterations", "speed"
      ],
      "properties": {
        "input_tokens": {"$ref": "#/$defs/nonnegative_integer"},
        "cache_creation_input_tokens": {"$ref": "#/$defs/nonnegative_integer"},
        "cache_read_input_tokens": {"$ref": "#/$defs/nonnegative_integer"},
        "output_tokens": {"$ref": "#/$defs/nonnegative_integer"},
        "server_tool_use": {"$ref": "#/$defs/server_tool_use"},
        "service_tier": {"type": "string", "minLength": 1},
        "cache_creation": {"$ref": "#/$defs/cache_creation"},
        "inference_geo": {"type": "string", "minLength": 1},
        "iterations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/iteration"}},
        "speed": {"type": "string", "minLength": 1}
      }
    },
    "model_usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inputTokens", "outputTokens", "cacheReadInputTokens",
        "cacheCreationInputTokens", "webSearchRequests", "costUSD",
        "contextWindow", "maxOutputTokens", "canonicalModel", "provider"
      ],
      "properties": {
        "inputTokens": {"$ref": "#/$defs/nonnegative_integer"},
        "outputTokens": {"$ref": "#/$defs/nonnegative_integer"},
        "cacheReadInputTokens": {"$ref": "#/$defs/nonnegative_integer"},
        "cacheCreationInputTokens": {"$ref": "#/$defs/nonnegative_integer"},
        "webSearchRequests": {"const": 0},
        "costUSD": {"type": "number", "minimum": 0},
        "contextWindow": {"type": "integer", "minimum": 1},
        "maxOutputTokens": {"type": "integer", "minimum": 1},
        "canonicalModel": {"type": "string", "minLength": 1},
        "provider": {"type": "string", "minLength": 1}
      }
    }
  }
}
