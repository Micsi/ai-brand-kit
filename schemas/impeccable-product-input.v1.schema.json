{
  "$id": "impeccable-product-input.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "platform", "users", "purpose", "positioning", "operating_context", "capabilities_constraints", "evidence", "principles", "representative_components"],
  "properties": {
    "schema_version": {"const": "brandkit-impeccable-product.v1"},
    "platform": {"enum": ["web", "ios", "android", "adaptive"]},
    "stack": {"type": "string", "minLength": 1},
    "users": {"type": "string", "minLength": 1},
    "purpose": {"type": "string", "minLength": 1},
    "positioning": {"type": "string", "minLength": 1},
    "operating_context": {"type": "string", "minLength": 1},
    "capabilities_constraints": {"type": "string", "minLength": 1},
    "brand_commitments": {"type": "string", "minLength": 1},
    "evidence": {"type": "string", "minLength": 1},
    "principles": {"type": "array", "minItems": 3, "maxItems": 5, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "accessibility": {"type": "string", "minLength": 1},
    "representative_components": {"type": "array", "minItems": 5, "maxItems": 10, "items": {"type": "object", "additionalProperties": false, "required": ["id", "name", "category", "description", "tokens"], "properties": {"id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"}, "name": {"type": "string", "minLength": 1}, "category": {"enum": ["button", "input", "nav", "chip", "card", "custom"]}, "description": {"type": "string", "minLength": 1}, "tokens": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "minLength": 1}}}}}
  }
}
