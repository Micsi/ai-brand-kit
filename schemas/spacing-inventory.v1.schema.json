{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "spacing-inventory.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "brand_pin", "target_scope", "entries"],
  "properties": {
    "schema_version": {"const": "spacing-inventory.v1"},
    "brand_pin": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "version", "manifest_sha256"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "target_scope": {"type": "string", "minLength": 1},
    "entries": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "source", "resolved_value", "medium", "assignment"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$"},
          "source": {
            "type": "object", "additionalProperties": false,
            "required": ["path", "line", "column"],
            "properties": {
              "path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
              "line": {"type": "integer", "minimum": 1},
              "column": {"type": "integer", "minimum": 1}
            }
          },
          "resolved_value": {"type": "string", "minLength": 1},
          "medium": {"enum": ["shared", "ui", "web", "pdf"]},
          "assignment": {"oneOf": [
            {
              "type": "object", "additionalProperties": false,
              "required": ["kind", "token"],
              "properties": {"kind": {"const": "token"}, "token": {"type": "string", "minLength": 1}}
            },
            {
              "type": "object", "additionalProperties": false,
              "required": ["kind", "reason", "evidence"],
              "properties": {
                "kind": {"const": "exception"},
                "reason": {"type": "string", "minLength": 1},
                "evidence": {"type": "string", "minLength": 1}
              }
            }
          ]}
        }
      }
    }
  }
}
