{
  "allowed_elements": ["heading", "paragraph", "ordered-list", "unordered-list", "link", "footnote", "table", "image", "callout", "mermaid", "page-break"],
  "allowed_overrides": {"section_numbering": [false], "toc": [false, true]},
  "engine_compatibility": "^1.0.0", "extends": "report",
  "forbidden_features": ["active-content", "embedded-credentials", "external-resources", "raw-html", "embedded-css", "unknown-directives", "unknown-code-fences"],
  "hash_policy": "sha256", "id": "report", "layout": {"footer": true, "header": true, "manual_page_break": true, "toc": true},
  "minimum_margin_mm": 20, "pagination": {"content_start": 1, "format": "Seite X von Y", "title_page_number": null},
  "publication_gates": ["contract-valid", "no-open-todos", "assets-resolved", "rights-valid", "protected-hashes-stable", "render-success"],
  "rights_required": true, "schema_version": "document-type.v1",
  "sections": {"optional": ["scope", "methodology", "recommendations", "sources"], "order": ["executive-summary", "scope", "methodology", "findings", "recommendations", "conclusion", "sources"], "required": ["executive-summary", "findings", "conclusion"]},
  "version": "1.0.0"
}
