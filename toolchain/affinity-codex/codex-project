#!/bin/sh
set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
bridge="$script_dir/affinity-codex-bridge.mjs"
node_bin=$(command -v node)

if [ ! -f "$bridge" ]; then
  printf '%s\n' "Affinity Codex bridge missing: $bridge" >&2
  exit 1
fi

case "${AFFINITY_MCP_SSE_URL:-http://127.0.0.1:6767/sse}" in
  http://127.0.0.1:*/*|http://\[::1\]:*/*) ;;
  *) printf '%s\n' "AFFINITY_MCP_SSE_URL must use an explicit loopback address" >&2; exit 1 ;;
esac

args_toml="[\"$bridge\"]"
exec codex \
  -c "mcp_servers.affinity.command=\"$node_bin\"" \
  -c "mcp_servers.affinity.args=$args_toml" \
  -c 'mcp_servers.affinity.startup_timeout_sec=30' \
  "$@"

